# Database URL (defaults to SQLite if not provided)
# For SQLite: sqlite:///./todo.db
# For PostgreSQL: postgresql://username:password@localhost:5432/tododb
DATABASE_URL=sqlite:///./todo.db

# JWT Secret Key
SECRET_KEY=super-secret-todo-jwt-key-change-in-production

# JWT Expiration in minutes (e.g. 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
