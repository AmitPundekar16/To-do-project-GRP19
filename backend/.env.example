# Reference values only; the app reads process environment variables and does
# not load this file automatically.
# SQLite is the supported default for local development.
DATABASE_URL=sqlite:///./todo.db

# Set a private value before deployment.
SECRET_KEY=super-secret-todo-jwt-key-change-in-production

# JWT Expiration in minutes (e.g. 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
